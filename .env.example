# Local-only identity (disabled in production)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret
WORKSPACE_DEV_USER_EMAIL=user@example.com

# Databases
DATABASE_URL=postgresql://user:password@localhost:5432/workspace
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=workspace
MONGODB_DATABASE_AI=workspace_ai
MONGODB_TLS=false
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CA_FILE=
MONGODB_CERT_KEY_FILE=

# Workspace file storage
WORKSPACE_RESOURCE_STORAGE=database
WORKSPACE_RESOURCE_ORPHAN_GRACE_HOURS=24
PROJECT_KNOWLEDGE_STORAGE=database
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_REGION=
OSS_SECURE=true

# Workspace realtime
WORKSPACE_WS_TOKEN_SECRET=replace-with-a-random-secret
MINDMAP_WS_TOKEN_SECRET=replace-with-a-random-secret
MINDMAP_WS_INTERNAL_URL=
# Run pnpm workspace:ws for the Document-aware Workspace room service.
WORKSPACE_WS_INTERNAL_URL=http://localhost:3002
WORKSPACE_WS_PORT=3002
WORKSPACE_WS_HOST=127.0.0.1
NEXT_PUBLIC_WORKSPACE_WS_URL=ws://localhost:3002
NEXT_PUBLIC_MINDMAP_WS_URL=ws://localhost:3001

# Workspace AI agent (Dify)
WORKSPACE_AGENT_DIFY_API_URL=
WORKSPACE_AGENT_DIFY_API_KEY=
WORKSPACE_AGENT_MODEL_STEP_DIFY_API_URL=
WORKSPACE_AGENT_MODEL_STEP_DIFY_API_KEY=
WORKSPACE_AGENT_LOCAL_DIFY_API_URL=
WORKSPACE_AGENT_LOCAL_DIFY_API_KEY=
NEXT_PUBLIC_AGENT_API_URL=
NEXT_PUBLIC_DIFY_API_URL=
CHAT_KEY=
IMAGE_KEY=
VIDEO_GEN_EDIT_KEY=
WORKSPACE_IMAGE_CAPTION_KEY=
WORKSPACE_AGENT_TOKEN_SECRET=replace-with-a-random-secret
WORKSPACE_AGENT_SERVICE_KEY=
WORKSPACE_AGENT_SERVICE_KEY_LOCAL=
WORKSPACE_AGENT_ALLOW_INSECURE_LOCAL_AUTH=false
WORKSPACE_INTERNAL_API_ORIGIN=http://localhost:3000
NEXT_PUBLIC_WORKSPACE_RUNTIME_DEFAULT=
WORKSPACE_AUTO_CHECKPOINT_INTERVAL_MS=30000
WORKSPACE_AUTO_CHECKPOINT_KEEP=20
WORKSPACE_RUNTIME_DEBUG=false
AI_USAGE_CAPTURE_DISABLED=false

# Optional local document conversion
SOFFICE_PATH=
MARKITDOWN_PYTHON_BIN=

# Optional comma-separated production invite allowlist
WORKSPACE_ALLOWED_EMAIL_DOMAINS=

# Optional remote image host (without protocol)
WORKSPACE_ASSET_HOST=
